# ---------- Base ----------
PORTAL_DATABASE_URL=sqlite:///./portal.db
# demo = carrega utilizadores e pedidos fictícios numa base vazia (só para testes). 0 = base limpa
PORTAL_SEED=0
# Chave para assinar a sessão (obrigatória com entra). Gerar com:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
PORTAL_SECRET_KEY=
# Endereço público do portal (links nos emails e redirect do login)
PORTAL_URL_BASE=http://localhost:8010
# 1 quando o portal estiver atrás de HTTPS (cookie de sessão só segue por HTTPS)
PORTAL_HTTPS=0

# ---------- Início de sessão ----------
# dev = escolher utilizador numa lista (demonstração) | entra = conta Microsoft
PORTAL_AUTH_MODE=dev
# Emails com perfil de administrador DSI (aprovam pedidos). Em modo dev, numa base vazia, são criados no arranque
PORTAL_ADMINS=
# 1 = quem entra com conta Microsoft e não existe no portal é criado como colaborador
PORTAL_AUTO_CRIAR=1

# ---------- Entra ID / Microsoft Graph ----------
ENTRA_TENANT_ID=
ENTRA_CLIENT_ID=
ENTRA_CLIENT_SECRET=

# ---------- Email ----------
# Caixa partilhada do Helpdesk: envia as notificações e recebe pedidos por email
PORTAL_CAIXA_HELPDESK=
# 1 = cria pedidos a partir dos emails recebidos na caixa do Helpdesk
PORTAL_LER_CAIXA=0
# 1 = avisa os técnicos do Helpdesk quando há um pedido novo para tratar
PORTAL_NOTIFICAR_HELPDESK=1

# ---------- Tarefas em segundo plano ----------
PORTAL_INTERVALO_SEG=60
# Sincronização com o Entra ID a cada N horas
PORTAL_SYNC_HORAS=24
# Opcional: só sincronizar membros deste grupo (id do grupo no Entra ID)
PORTAL_SYNC_GRUPO=

# ---------- Identidade ----------
PORTAL_EMPRESA=MHAIS
PORTAL_NOME=Gestor de Pedidos DSI
PORTAL_DIRECCAO=Direcção de Sistemas de Informação
# Logotipo: colocar o ficheiro em portal/static/marca/ (logo.svg por omissão)
PORTAL_LOGO=/static/marca/logo.svg
# Versão branca para o cabeçalho roxo
PORTAL_LOGO_CABECALHO=/static/marca/logo-branco.svg
PORTAL_CONTACTO_EMAIL=
PORTAL_CONTACTO_TELEFONE=
PORTAL_HORARIO=Segunda a sexta, 08:00 às 17:00
# Cor da barra dos emails (hexadecimal, a mesma de --primaria em marca.css)
PORTAL_COR_EMAIL=#5b2a86
