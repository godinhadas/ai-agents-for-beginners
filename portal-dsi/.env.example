# Base de dados (SQLite por omissão)
PORTAL_DATABASE_URL=sqlite:///./portal.db
# 1 = carrega dados de demonstração se a base estiver vazia
PORTAL_SEED=1
# dev = escolher utilizador numa lista, sem palavra-passe (só para testes, nunca em rede)
PORTAL_AUTH_MODE=dev
# Chave para assinar a sessão. Gerar com: python -c "import secrets; print(secrets.token_urlsafe(32))"
PORTAL_SECRET_KEY=
