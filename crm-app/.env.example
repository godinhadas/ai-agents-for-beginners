# Base de dados (SQLite por omissão; em produção, ex.: mssql+pyodbc://... ou postgresql+psycopg://...)
CRM_DATABASE_URL=sqlite:///./crm.db
# 1 = carrega dados de demonstração se a base estiver vazia
CRM_SEED=1

# Agente IA (API compatível com OpenAI). Por omissão: GitHub Models.
GITHUB_TOKEN=
